# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# GOOGLE_SHEET_ID: The ID of the Google Sheet containing the current dashboard data.
GOOGLE_SHEET_ID=""

# LEGACY_SHEET_ID: The ID of the Google Sheet containing the legacy data.
LEGACY_SHEET_ID=""
